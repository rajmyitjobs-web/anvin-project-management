+ public static bool Linked(JsonObject t)=>J.A(t,"allocations").Any()||J.A(t,"sessions").Any()||J.A(t,"history").Any()||J.S(t,"actualStart")!=""||J.S(t,"actualFinish")!=""||J.S(t,"implementationPlanRowId")!=""||J.S(t,"planImportReference")!="";
